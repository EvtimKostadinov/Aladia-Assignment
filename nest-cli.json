{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/nestjs-microservice-challenge/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/nestjs-microservice-challenge/tsconfig.app.json",
    "plugins": [
      {
        "name": "@nestjs/swagger/plugin",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  },
  "monorepo": true,
  "root": "apps/nestjs-microservice-challenge",
  "projects": {
    "authentication": {
      "type": "application",
      "root": "apps/authentication",
      "entryFile": "main",
      "sourceRoot": "apps/authentication/src",
      "compilerOptions": {
        "tsConfigPath": "apps/authentication/tsconfig.app.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "nestjs-microservice-challenge": {
      "type": "application",
      "root": "apps/nestjs-microservice-challenge",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-microservice-challenge/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-microservice-challenge/tsconfig.app.json"
      }
    }
  }
}